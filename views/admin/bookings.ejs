<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head', { pageTitle: 'Manage Bookings' }) %></head>
<body>
<%- include('../partials/toasts') %>
<%- include('../partials/navbar', {}) %>

<div class="dash-shell">
  <%- include('../partials/admin-sidebar', { active: 'bookings' }) %>

  <main class="dash-main">
    <%- include('../partials/dash-toggle') %>
    <div class="dash-header"><div><h1>Manage Bookings</h1><p><%= bookings.length %> booking<%= bookings.length===1?'':'s' %> found.</p></div></div>

    <form method="GET" action="/admin/bookings" class="flex gap-8" style="margin-bottom:20px; max-width:260px;" data-no-loading>
      <select class="form-control" name="status" onchange="this.form.submit()">
        <option value="">All Statuses</option>
        <option value="pending" <%= status==='pending'?'selected':'' %>>Pending</option>
        <option value="accepted" <%= status==='accepted'?'selected':'' %>>Accepted</option>
        <option value="completed" <%= status==='completed'?'selected':'' %>>Completed</option>
        <option value="rejected" <%= status==='rejected'?'selected':'' %>>Rejected</option>
        <option value="cancelled" <%= status==='cancelled'?'selected':'' %>>Cancelled</option>
      </select>
    </form>

    <div class="panel">
      <% if (bookings.length === 0) { %>
        <div class="empty-state"><i class="fa-solid fa-calendar-check"></i><p>No bookings found.</p></div>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Student</th><th>Tutor</th><th>Subject</th><th>Date</th><th>Status</th><th>Update</th></tr></thead>
            <tbody>
              <% bookings.forEach(function(b) { %>
                <tr>
                  <td><%= b.student_name %></td>
                  <td><%= b.tutor_name %></td>
                  <td><%= b.subject_name %></td>
                  <td><%= b.session_date %></td>
                  <td><span class="badge badge-<%= b.status %>"><%= b.status %></span></td>
                  <td>
                    <form method="POST" action="/admin/bookings/<%= b.id %>/status" class="flex gap-8" data-no-loading>
                      <select class="form-control" name="status" style="padding:6px 10px; font-size:.82rem;">
                        <option value="pending" <%= b.status==='pending'?'selected':'' %>>Pending</option>
                        <option value="accepted" <%= b.status==='accepted'?'selected':'' %>>Accepted</option>
                        <option value="completed" <%= b.status==='completed'?'selected':'' %>>Completed</option>
                        <option value="rejected" <%= b.status==='rejected'?'selected':'' %>>Rejected</option>
                        <option value="cancelled" <%= b.status==='cancelled'?'selected':'' %>>Cancelled</option>
                      </select>
                      <button type="submit" class="btn btn-ghost btn-sm">Update</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>
</div>

<script src="/js/main.js"></script>
</body>
</html>
