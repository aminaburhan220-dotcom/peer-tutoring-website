<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head', { pageTitle: 'Reports' }) %></head>
<body>
<%- include('../partials/toasts') %>
<%- include('../partials/navbar', {}) %>

<div class="dash-shell">
  <%- include('../partials/admin-sidebar', { active: 'reports' }) %>

  <main class="dash-main">
    <%- include('../partials/dash-toggle') %>
    <div class="dash-header"><div><h1>Reports</h1><p>Platform trends and top performers.</p></div></div>

    <div class="grid grid-2" style="align-items:start;">
      <div class="panel">
        <div class="panel-head"><h2>Bookings per Month</h2></div>
        <% if (monthlyBookings.length === 0) { %>
          <div class="empty-state"><i class="fa-solid fa-chart-column"></i><p>Not enough data yet.</p></div>
        <% } else { %>
          <canvas data-chart='<%- JSON.stringify(monthlyBookings.map(function(m){return {label:m.month, value:m.count}})) %>' style="width:100%; height:220px;"></canvas>
        <% } %>
      </div>
      <div class="panel">
        <div class="panel-head"><h2>Subject Popularity</h2></div>
        <canvas data-chart='<%- JSON.stringify(subjectPopularity.map(function(s){return {label:s.name, value:s.count}})) %>' style="width:100%; height:220px;"></canvas>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head"><h2>Top Rated Tutors</h2></div>
      <% if (topTutors.length === 0) { %>
        <div class="empty-state"><i class="fa-solid fa-star"></i><p>No approved tutors yet.</p></div>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Tutor</th><th>Rating</th><th>Sessions</th></tr></thead>
            <tbody>
              <% topTutors.forEach(function(t) { %>
                <tr><td><%= t.full_name %></td><td><i class="fa-solid fa-star" style="color:var(--warning);"></i> <%= t.average_rating.toFixed(1) %></td><td><%= t.total_sessions %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>
</div>

<script src="/js/main.js"></script>
</body>
</html>
