<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head', { pageTitle: 'Settings' }) %></head>
<body>
<%- include('../partials/toasts') %>
<%- include('../partials/navbar', {}) %>

<div class="dash-shell">
  <%- include('../partials/admin-sidebar', { active: 'settings' }) %>

  <main class="dash-main">
    <%- include('../partials/dash-toggle') %>
    <div class="dash-header"><div><h1>Settings</h1><p>Manage your admin profile and account security.</p></div></div>

    <div class="panel" style="max-width:520px;">
      <div class="panel-head"><h2>My Profile</h2></div>
      <form method="POST" action="/admin/settings/profile" data-validate>
        <div class="form-group">
          <label for="full_name">Full Name</label>
          <input class="form-control" type="text" id="full_name" name="full_name" value="<%= currentUser.full_name %>" required>
        </div>
        <div class="form-group">
          <label>Email</label>
          <input class="form-control" type="email" value="<%= currentUser.email %>" disabled>
        </div>
        <button type="submit" class="btn btn-primary">Save Profile</button>
      </form>
    </div>

    <div class="panel" style="max-width:520px;">
      <div class="panel-head"><h2>Change Password</h2></div>
      <form method="POST" action="/admin/settings/password" data-validate>
        <div class="form-group">
          <label for="current_password">Current Password</label>
          <div class="password-field">
            <input class="form-control" type="password" id="current_password" name="current_password" required>
            <button type="button" class="password-toggle" data-target="current_password">Show</button>
          </div>
        </div>
        <div class="form-group">
          <label for="new_password">New Password</label>
          <div class="password-field">
            <input class="form-control" type="password" id="new_password" name="new_password" minlength="6" required>
            <button type="button" class="password-toggle" data-target="new_password">Show</button>
          </div>
        </div>
        <div class="form-group">
          <label for="confirm_password">Confirm New Password</label>
          <div class="password-field">
            <input class="form-control" type="password" id="confirm_password" name="confirm_password" minlength="6" required>
            <button type="button" class="password-toggle" data-target="confirm_password">Show</button>
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Update Password</button>
      </form>
    </div>
  </main>
</div>

<script src="/js/main.js"></script>
</body>
</html>
