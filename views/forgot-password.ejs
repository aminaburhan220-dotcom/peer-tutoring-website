<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { pageTitle: 'Forgot Password' }) %></head>
<body>
<%- include('partials/toasts') %>
<%- include('partials/navbar', {}) %>

<div class="auth-shell">
  <div class="auth-card">
    <h1>Reset your password</h1>
    <p class="lead">Enter your email and we'll send reset instructions.</p>

    <form method="POST" action="/forgot-password" data-validate>
      <div class="form-group">
        <label for="email">Email</label>
        <input class="form-control" type="email" id="email" name="email" required autofocus>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Send Reset Link</button>
    </form>

    <p class="auth-switch"><a href="/login"><i class="fa-solid fa-arrow-left"></i> Back to Log In</a></p>
  </div>
</div>

<script src="/js/main.js"></script>
</body>
</html>
