<% } else if (_name === 'Artificial Intelligence') { %>
  <div class="subject-illustration illus-ai">
    <svg viewBox="0 0 160 120" width="88" height="72" fill="none">
      <path d="M60 30 Q40 30 38 48 Q28 50 28 65 Q28 80 42 82 Q42 95 58 95 Q65 100 75 95 Q90 98 95 85 Q108 85 108 68 Q112 55 100 48 Q100 32 82 30 Q70 24 60 30 Z" stroke="#172B4D" stroke-width="2.5" stroke-linejoin="round"/>
