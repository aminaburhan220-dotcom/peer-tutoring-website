      <line x1="55" y1="55" x2="75" y2="48" stroke="#D9A441" class="accent-teal" stroke-width="1.5"/>
      <line x1="75" y1="48" x2="85" y2="68" stroke="#D9A441" class="accent-teal" stroke-width="1.5"/>
      <line x1="85" y1="68" x2="60" y2="75" stroke="#D9A441" class="accent-teal" stroke-width="1.5"/>
      <line x1="55" y1="55" x2="60" y2="75" stroke="#D9A441" class="accent-teal" stroke-width="1.5"/>
    </svg>
  </div>
<% } else if (_name === 'Cybersecurity') { %>
  <div class="subject-illustration illus-cyber">
    <svg viewBox="0 0 160 120" width="80" height="80" fill="none">
      <path d="M80 20 L120 33 L120 62 Q120 90 80 102 Q40 90 40 62 L40 33 Z" stroke="#172B4D" stroke-width="3" stroke-linejoin="round"/>
      <rect x="65" y="58" width="30" height="24" rx="4" stroke="#D9A441" class="accent-teal" stroke-width="2.5" fill="#F8FAFC"/>
      <path d="M71 58 L71 48 Q71 38 80 38 Q89 38 89 48 L89 58" stroke="#D9A441" class="accent-teal" stroke-width="2.5"/>
      <circle cx="80" cy="70" r="3.5" fill="#D9A441"/>
