      <line x1="120" y1="52" x2="120" y2="72" stroke="#172B4D" stroke-width="3" stroke-linecap="round"/>
      <line x1="110" y1="62" x2="130" y2="62" stroke="#172B4D" stroke-width="3" stroke-linecap="round"/>
      <circle cx="120" cy="90" r="4" fill="#D9A441"/>
    </svg>
  </div>
<% } else if (_name === 'Data Science') { %>
  <div class="subject-illustration illus-data">
    <svg viewBox="0 0 160 120" width="92" height="76" fill="none">
      <rect x="20" y="20" width="120" height="80" rx="12" stroke="#172B4D" stroke-width="2.5" fill="#F8FAFC"/>
