  </div>
<% } else if (_name === 'Database Systems') { %>
  <div class="subject-illustration illus-database">
    <svg viewBox="0 0 160 120" width="80" height="80" fill="none">
      <ellipse cx="80" cy="28" rx="35" ry="10" stroke="#172B4D" stroke-width="3"/>
      <path d="M45 28 L45 53 Q45 63 80 63 Q115 63 115 53 L115 28" stroke="#172B4D" stroke-width="3"/>
      <ellipse cx="80" cy="53" rx="35" ry="10" stroke="#172B4D" stroke-width="2.5"/>
      <path d="M45 53 L45 78 Q45 88 80 88 Q115 88 115 78 L115 53" stroke="#D9A441" class="accent-teal" stroke-width="3"/>
      <ellipse cx="80" cy="78" rx="35" ry="10" stroke="#D9A441" class="accent-teal" stroke-width="2.5"/>
      <circle cx="80" cy="78" r="3.5" fill="#D9A441"/>
    </svg>
  </div>
<% } else if (_name === 'Science') { %>
  <div class="subject-illustration illus-science">
    <svg viewBox="0 0 160 120" width="80" height="80" fill="none">
      <path d="M68 24 L68 55 L44 92 Q40 98 48 98 L112 98 Q120 98 116 92 L92 55 L92 24" stroke="#172B4D" stroke-width="3" stroke-linejoin="round"/>
      <line x1="60" y1="24" x2="100" y2="24" stroke="#172B4D" stroke-width="3" stroke-linecap="round"/>
      <path d="M52 80 Q80 68 108 80 L112 92 Q120 98 116 98 L48 98 Q40 98 44 92 Z" fill="#FAF0DC"/>
      <circle cx="80" cy="45" r="14" stroke="#D9A441" class="accent-teal" stroke-width="2.5" fill="none"/>
      <circle cx="80" cy="45" r="3" fill="#D9A441" class="accent-teal"/>
      <circle cx="72" cy="38" r="3" fill="#D9A441"/>
      <circle cx="88" cy="38" r="3" fill="#D9A441" class="accent-teal"/>
      <line x1="80" y1="45" x2="72" y2="38" stroke="#D9A441" class="accent-teal" stroke-width="1.5"/>
      <line x1="80" y1="45" x2="88" y2="38" stroke="#D9A441" class="accent-teal" stroke-width="1.5"/>
    </svg>
  </div>
<% } else if (_name === 'Business & Economics' || _name === 'Business') { %>
  <div class="subject-illustration illus-business">
    <svg viewBox="0 0 160 120" width="92" height="76" fill="none">
      <line x1="30" y1="30" x2="30" y2="95" stroke="#172B4D" stroke-width="2.5" stroke-linecap="round"/>
      <line x1="30" y1="95" x2="130" y2="95" stroke="#172B4D" stroke-width="2.5" stroke-linecap="round"/>
      <rect x="42" y="70" width="14" height="25" rx="2" fill="#172B4D"/>
      <rect x="64" y="55" width="14" height="40" rx="2" fill="#D9A441" class="accent-teal"/>
      <rect x="86" y="65" width="14" height="30" rx="2" fill="#172B4D"/>
      <polyline points="42,50 64,38 86,44 108,26" stroke="#D9A441" class="accent-teal" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M100 26 L108 26 L108 34" stroke="#D9A441" class="accent-teal" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="108" cy="26" r="4" fill="#D9A441"/>
    </svg>
  </div>
<% } else { %>
  <div class="subject-illustration illus-default">
    <svg viewBox="0 0 160 120" width="80" height="72" fill="none">
      <path d="M80 30 L140 55 L80 80 L20 55 Z" stroke="#172B4D" stroke-width="3" stroke-linejoin="round"/>
      <path d="M45 65 L45 88 Q45 96 80 96 Q115 96 115 88 L115 65" stroke="#D9A441" class="accent-teal" stroke-width="2.5"/>
      <circle cx="80" cy="55" r="3.5" fill="#D9A441"/>
    </svg>
  </div>
<% } %>
