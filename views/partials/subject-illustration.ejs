<%
/* Renders a custom vector illustration for a given subject name, inside a
   tinted rounded container. Falls back to a generic graduation-cap mark for
   any subject name not explicitly designed (e.g. a new one an admin adds),
   so this never breaks if the subject list changes. */
const _name = (typeof subjectName !== 'undefined' ? subjectName : '');
%>
<% if (_name === 'English') { %>
  <div class="subject-illustration illus-english">
    <svg viewBox="0 0 160 120" width="88" height="72" fill="none">
      <path d="M20 85 Q20 40 45 38 Q65 37 78 45 L78 90 Q65 82 45 83 Q30 84 20 85 Z" stroke="#172B4D" stroke-width="3" stroke-linejoin="round"/>
      <path d="M140 85 Q140 40 115 38 Q95 37 82 45 L82 90 Q95 82 115 83 Q130 84 140 85 Z" stroke="#172B4D" stroke-width="3" stroke-linejoin="round"/>
      <line x1="80" y1="45" x2="80" y2="90" stroke="#172B4D" stroke-width="2.5"/>
      <text x="42" y="30" font-family="Manrope, sans-serif" font-weight="700" font-size="18" fill="#D9A441" class="accent-teal">A</text>
      <text x="70" y="22" font-family="Manrope, sans-serif" font-weight="700" font-size="14" fill="#D9A441">B</text>
      <text x="94" y="28" font-family="Manrope, sans-serif" font-weight="700" font-size="16" fill="#D9A441" class="accent-teal">C</text>
    </svg>
  </div>
<% } else if (_name === 'Spanish') { %>
  <div class="subject-illustration illus-spanish">
    <svg viewBox="0 0 160 120" width="88" height="72" fill="none">
      <rect x="20" y="26" width="80" height="52" rx="16" stroke="#172B4D" stroke-width="3"/>
      <path d="M35 78 L35 96 L54 78 Z" fill="#172B4D"/>
      <rect x="65" y="52" width="72" height="46" rx="14" stroke="#D9A441" class="accent-teal" stroke-width="3" fill="#F8FAFC"/>
      <path d="M120 98 L120 112 L102 98 Z" fill="#D9A441" class="accent-teal"/>
      <circle cx="45" cy="52" r="3" fill="#D9A441"/>
      <circle cx="60" cy="52" r="3" fill="#172B4D"/>
      <circle cx="75" cy="52" r="3" fill="#172B4D"/>
    </svg>
  </div>
<% } else if (_name === 'Web Development') { %>
  <div class="subject-illustration illus-webdev">
    <svg viewBox="0 0 160 120" width="92" height="76" fill="none">
      <rect x="20" y="18" width="120" height="80" rx="12" stroke="#D9A441" class="accent-teal" stroke-width="3" fill="#F8FAFC"/>
      <line x1="20" y1="38" x2="140" y2="38" stroke="#D9A441" class="accent-teal" stroke-width="2.5"/>
      <circle cx="32" cy="28" r="3" fill="#D9A441"/>
      <circle cx="44" cy="28" r="3" fill="#172B4D"/>
      <circle cx="56" cy="28" r="3" fill="#172B4D"/>
      <text x="38" y="78" font-family="'Courier New', monospace" font-weight="700" font-size="30" fill="#172B4D">&lt;/&gt;</text>
    </svg>
  </div>
<% } else if (_name === 'Computer Science') { %>
  <div class="subject-illustration illus-cs">
    <svg viewBox="0 0 160 120" width="88" height="72" fill="none">
      <rect x="55" y="35" width="50" height="50" rx="8" stroke="#172B4D" stroke-width="3"/>
      <line x1="65" y1="35" x2="65" y2="24" stroke="#172B4D" stroke-width="2.5" stroke-linecap="round"/>
      <line x1="80" y1="35" x2="80" y2="24" stroke="#172B4D" stroke-width="2.5" stroke-linecap="round"/>
      <line x1="95" y1="35" x2="95" y2="24" stroke="#172B4D" stroke-width="2.5" stroke-linecap="round"/>
      <line x1="65" y1="85" x2="65" y2="96" stroke="#172B4D" stroke-width="2.5" stroke-linecap="round"/>
      <line x1="80" y1="85" x2="80" y2="96" stroke="#172B4D" stroke-width="2.5" stroke-linecap="round"/>
      <line x1="95" y1="85" x2="95" y2="96" stroke="#172B4D" stroke-width="2.5" stroke-linecap="round"/>
      <line x1="55" y1="50" x2="44" y2="50" stroke="#172B4D" stroke-width="2.5" stroke-linecap="round"/>
      <line x1="55" y1="70" x2="44" y2="70" stroke="#172B4D" stroke-width="2.5" stroke-linecap="round"/>
