      <line x1="105" y1="70" x2="116" y2="70" stroke="#172B4D" stroke-width="2.5" stroke-linecap="round"/>
      <circle cx="70" cy="55" r="3.5" fill="#D9A441" class="accent-teal"/>
      <circle cx="90" cy="65" r="3.5" fill="#D9A441"/>
      <line x1="70" y1="55" x2="90" y2="65" stroke="#D9A441" class="accent-teal" stroke-width="2"/>
