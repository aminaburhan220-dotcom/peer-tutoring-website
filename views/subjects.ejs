<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { pageTitle: 'Subjects' }) %></head>
<body>
<%- include('partials/toasts') %>
<%- include('partials/navbar', { active: 'subjects' }) %>

<section class="page-header">
  <div class="container">
    <span class="eyebrow">Subjects</span>
    <h1>What would you like to learn?</h1>
    <p style="max-width:560px; margin:0 auto;">Browse our subject areas and connect with a peer tutor who knows the material inside and out.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="grid grid-3">
      <% subjects.forEach(function(s) { %>
        <div class="card subject-card">
          <div class="subject-icon"><i class="fa-solid <%= s.icon || 'fa-book' %>"></i></div>
          <h3><%= s.name %></h3>
          <p><%= s.description %></p>
          <div class="subject-meta">
            <span class="count-pill"><%= s.tutorCount %> tutors available</span>
            <a href="/find-tutors?subject=<%= encodeURIComponent(s.name) %>" class="btn btn-ghost btn-sm">View Tutors <i class="fa-solid fa-arrow-right"></i></a>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
