<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head', { pageTitle: 'Tutor Dashboard' }) %></head>
<body>
<%- include('../partials/toasts') %>
<%- include('../partials/navbar', {}) %>

<div class="dash-shell">
  <%- include('../partials/tutor-sidebar', { active: 'dashboard' }) %>

  <main class="dash-main">
    <%- include('../partials/dash-toggle') %>
    <div class="dash-header">
      <div>
        <h1>Welcome back, <%= currentUser.full_name.split(' ')[0] %> 👋</h1>
        <p>
          <% if (tutor.status === 'pending') { %>
            <span class="badge badge-pending">Pending Approval</span> Your profile is awaiting admin review and isn't publicly visible yet.
          <% } else if (tutor.status === 'rejected') { %>
            <span class="badge badge-rejected">Not Approved</span> Please contact support for more information.
          <% } else { %>
            <span class="badge badge-accepted">Approved</span> Your profile is live and visible to students.
          <% } %>
        </p>
      </div>
    </div>

    <div class="grid grid-4" style="margin-bottom:28px;">
      <div class="card stat-card"><div class="icon"><i class="fa-solid fa-users"></i></div><div><div class="num"><%= totalStudents %></div><div class="label">Total Students</div></div></div>
      <div class="card stat-card"><div class="icon"><i class="fa-solid fa-calendar-check"></i></div><div><div class="num"><%= upcoming.length %></div><div class="label">Upcoming Sessions</div></div></div>
      <div class="card stat-card"><div class="icon"><i class="fa-solid fa-circle-check"></i></div><div><div class="num"><%= completedCount %></div><div class="label">Completed Sessions</div></div></div>
      <div class="card stat-card"><div class="icon"><i class="fa-solid fa-star"></i></div><div><div class="num"><%= tutor.average_rating.toFixed(1) %></div><div class="label">Average Rating</div></div></div>
    </div>

    <div class="panel">
      <div class="panel-head"><h2>Upcoming Sessions</h2><a href="/tutor/sessions" class="btn btn-ghost btn-sm">View all</a></div>
      <% if (upcoming.length === 0) { %>
        <div class="empty-state"><i class="fa-solid fa-calendar"></i><p>No upcoming sessions scheduled.</p></div>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Student</th><th>Subject</th><th>Date</th><th>Time</th></tr></thead>
            <tbody>
              <% upcoming.forEach(function(b) { %>
                <tr><td><%= b.student_name %></td><td><%= b.subject_name %></td><td><%= b.session_date %></td><td><%= b.start_time %>–<%= b.end_time %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>
</div>

<script src="/js/main.js"></script>
</body>
</html>
