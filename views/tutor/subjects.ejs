<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head', { pageTitle: 'My Subjects' }) %></head>
<body>
<%- include('../partials/toasts') %>
<%- include('../partials/navbar', {}) %>

<div class="dash-shell">
  <%- include('../partials/tutor-sidebar', { active: 'subjects' }) %>

  <main class="dash-main">
    <%- include('../partials/dash-toggle') %>
    <div class="dash-header"><div><h1>My Subjects</h1><p>Choose which subjects you teach.</p></div></div>

    <div class="panel" style="max-width:560px;">
      <form method="POST" action="/tutor/subjects">
        <div class="grid grid-2" style="gap:14px; margin-bottom:20px;">
          <% allSubjects.forEach(function(s) { %>
            <label style="display:flex; align-items:center; gap:10px; border:1.5px solid var(--line); border-radius:var(--radius-sm); padding:14px; cursor:pointer;">
              <input type="checkbox" name="subject_ids" value="<%= s.id %>" <%= mySubjectIds.includes(s.id) ? 'checked' : '' %>>
              <i class="fa-solid <%= s.icon || 'fa-book' %>" style="color:var(--primary);"></i>
              <%= s.name %>
            </label>
          <% }) %>
        </div>
        <button type="submit" class="btn btn-primary">Save Subjects</button>
      </form>
    </div>
  </main>
</div>

<script src="/js/main.js"></script>
</body>
</html>
